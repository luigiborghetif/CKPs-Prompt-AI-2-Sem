# Copie para .env, preencha sua chave e reinicie a aplicação.
OLLAMA_API_KEY=cole_sua_chave_aqui
OLLAMA_BASE_URL=https://ollama.com
OLLAMA_MODEL=gemma4:cloud
# Nome da API direta validado; o modelo lógico do enunciado permanece gemma4:cloud.
OLLAMA_API_MODEL=gemma4:31b

MODEL_TEMPERATURE=0
MODEL_MAX_TOKENS=900
MEMORY_TOKEN_LIMIT=1200
OLLAMA_TIMEOUT=90
MAX_INPUT_CHARS=4000
MAX_SESSIONS=100
SESSION_TTL_SECONDS=3600
APP_HOST=127.0.0.1
APP_PORT=7860

# CKP02: nenhuma chamada ao carregar a interface/notebook.
# Execução híbrida autorizada: embeddings locais e geração Cloud, sem fallback.
# O PDF pede embeddings Cloud; confirmar essa alternativa antes de entregar.
OLLAMA_EMBED_BASE_URL=http://localhost:11434
RAG_CHUNK_SIZE=256
RAG_CHUNK_OVERLAP=32
RAG_CANDIDATES=8
RAG_TOP_K=4
RAG_STORE_PATH=.chroma
# Escolha quantitativa atual: 256/32 sem reranking; comparação inclui o diferencial.
RAG_RERANK=false
RAG_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# Opcional: fixar revisão do modelo após verificar seu download.
RAG_RERANKER_REVISION=
RAG_RERANKER_LOCAL_ONLY=false
RAG_MODEL_CACHE_PATH=.model-cache
